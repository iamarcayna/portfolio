---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVisual from '@/components/projects/ProjectVisual.astro';
import CodeWindow from '@/components/ui/CodeWindow.astro';
import Contact from '@/components/contact/Contact.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], position: i + 1, total: projects.length },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
  position: number;
  total: number;
}

const { project, next, position, total } = Astro.props;
const { Content, headings } = await render(project);
const { title, summary, category, role, period, client, technologies, link, linkLabel, confidential, snippet } = project.data;
const sections = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="wrap pt-[calc(var(--header-h)+clamp(3rem,8vw,6rem))]">
      <a href="/#work" class="mono inline-flex items-center gap-2 text-muted hover:text-fg">
        <ArrowLeft class="size-3.5" stroke-width={2} aria-hidden="true" /> cd ~/work
      </a>

      <div class="grid-12 mt-10 gap-y-10">
        <div class="col-span-4 md:col-span-7">
          <p class="mono text-accent">
            {String(position).padStart(2, '0')}/{String(total).padStart(2, '0')} · {category}{confidential && ' · NDA'}
          </p>
          <h1 class="h-display mt-4">{title}</h1>
          <p class="lede mt-6 max-w-[36rem]">{summary}</p>
        </div>

        <dl class="mono col-span-4 grid grid-cols-[5rem_1fr] gap-y-2 self-end text-muted md:col-span-4 md:col-start-9">
          <dt>role</dt>
          <dd class="text-soft">{role}</dd>
          <dt>year</dt>
          <dd class="text-soft">{period}</dd>
          {client && (
            <>
              <dt>client</dt>
              <dd class="text-soft">{client}</dd>
            </>
          )}
          <dt>stack</dt>
          <dd class="text-soft">{technologies.join(', ')}</dd>
          {link && (
            <>
              <dt>live</dt>
              <dd>
                <a href={link} target="_blank" rel="noopener" class="link-draw inline-flex items-center gap-1 text-accent">
                  {linkLabel ?? link}
                  <ArrowUpRight class="size-3.5" stroke-width={2} aria-hidden="true" />
                  <span class="sr-only">(opens in new tab)</span>
                </a>
              </dd>
            </>
          )}
        </dl>
      </div>
    </header>

    {
      (project.data.cover || snippet) && (
        <div class="wrap mt-[clamp(3rem,6vw,5rem)]">
          <div class="grid-12 items-start gap-y-6">
            {project.data.cover && (
              <div class:list={['col-span-4 overflow-hidden rounded-[10px] border border-line', snippet ? 'md:col-span-8' : 'md:col-span-12']}>
                <ProjectVisual project={project} sizes="(min-width: 768px) 64vw, 94vw" eager />
              </div>
            )}
            {snippet && (
              <CodeWindow
                file={snippet.file}
                lang={snippet.lang}
                code={snippet.code}
                note={snippet.note}
                class:list={['col-span-4', project.data.cover ? 'md:col-span-4 md:mt-16' : 'md:col-span-8 md:col-start-3']}
              />
            )}
          </div>
        </div>
      )
    }

    <div class="wrap mt-[clamp(4rem,8vw,7rem)]">
      <div class="grid-12">
        <details class="case-sections col-span-4 mb-10 rounded-lg border border-line bg-panel md:hidden">
          <summary class="mono flex cursor-pointer items-center justify-between px-4 py-3 text-fg">
            <span><span class="text-accent">#</span> sections</span><span class="text-muted">{sections.length}</span>
          </summary>
          <nav aria-label="Sections" data-spy>
            <ol class="mono space-y-1 px-4 pb-4 text-muted">
              {sections.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="link-draw inline-block py-1.5">{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
        <nav aria-label="Sections" class="col-span-4 mb-12 hidden md:col-span-3 md:block" data-spy>
          <ol class="mono sticky top-[calc(var(--header-h)+2rem)] space-y-2.5 border-l border-line pl-4 text-muted">
            {sections.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="link-draw hover:text-fg">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
        <div class="case-body col-span-4 md:col-span-9 md:col-start-4">
          <Content />
        </div>
      </div>
    </div>

    <nav class="wrap mt-[clamp(6rem,12vw,10rem)]" aria-label="Next project">
      <a href={`/work/${next.id}/`} class="next glow group block rounded-[10px] border border-line bg-panel p-6 md:p-10">
        <span class="mono text-muted">next case study · {(position % total) + 1}/{total}</span>
        <span class="h-section mt-4 block">
          <span class="link-draw">{next.data.title}</span><span class="whitespace-nowrap">&#8288;<ArrowUpRight
              class="ml-[0.1em] inline-block size-[0.55em] align-[0.15em] text-accent transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1"
              stroke-width={2}
              aria-hidden="true"
            /></span>
        </span>
        <span class="mt-3 block max-w-xl text-soft">{next.data.summary}</span>
      </a>
    </nav>
  </article>
  <Contact />
</BaseLayout>

<style>
  details.case-sections > summary {
    list-style: none;
  }
  details.case-sections > summary::-webkit-details-marker {
    display: none;
  }
</style>
