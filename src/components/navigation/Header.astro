---
import { Command } from '@lucide/astro';
import { navigation, site } from '@/lib/site';

interface Props {
  isHome: boolean;
}

const { isHome } = Astro.props;
const links = navigation.map((item) => ({ ...item, href: isHome ? item.href.replace('/', '') : item.href }));
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="wrap flex h-[var(--header-h)] items-center justify-between gap-6">
    <a href="/" class="mono group flex items-center gap-1 text-fg" aria-label={`${site.name}, home`}>
      <span class="text-accent">~/</span><span>reymond</span><span class="caret" aria-hidden="true"></span>
    </a>

    <nav aria-label="Primary" class="hidden md:block" data-spy={isHome ? '' : undefined}>
      <ol class="mono flex gap-7 text-muted">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="link-draw hover:text-fg">
                {link.label.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" class="palette-trigger mono" data-palette-open aria-haspopup="dialog">
        <Command class="size-3.5" stroke-width={1.75} aria-hidden="true" />
        <span class="hidden sm:inline">Jump to…</span>
        <kbd class="hidden sm:inline" data-shortcut>⌘K</kbd>
        <span class="sr-only">Open command palette</span>
      </button>
      <button
        type="button"
        class="mono -mr-2 p-2 text-soft md:hidden"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        menu
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu m-0 h-dvh max-h-none w-screen max-w-none bg-abyss p-0 text-fg" aria-label="Menu" data-menu>
  <div class="wrap flex h-full flex-col">
    <div class="flex h-[var(--header-h)] items-center justify-between">
      <span class="mono"><span class="text-accent">~/</span>reymond</span>
      <button type="button" class="mono -mr-2 p-2 text-soft" data-menu-close>close</button>
    </div>
    <nav aria-label="Mobile" class="mt-auto pb-12">
      <ol class="space-y-2">
        {
          links.map((link) => (
            <li class="menu-item">
              <a href={link.href} class="flex items-baseline gap-3 py-1" data-menu-link>
                <span class="mono text-accent" aria-hidden="true">cd</span>
                <span class="text-[clamp(2.5rem,12vw,4rem)] font-semibold tracking-[-0.04em]">{link.label.toLowerCase()}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</dialog>

<style>
  .site-header {
    transition:
      translate 0.5s var(--ease-out-quint),
      background-color 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: color-mix(in oklab, var(--color-canvas) 88%, transparent);
    border-bottom-color: var(--color-line);
  }
  .site-header.is-hidden {
    translate: 0 -100%;
  }
  .site-header:focus-within {
    translate: 0 0;
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 2px;
    background: var(--color-accent);
    translate: 0 0.15em;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .palette-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    color: var(--color-muted);
    background: var(--color-panel);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .palette-trigger:hover {
    border-color: var(--color-line-strong);
    color: var(--color-fg);
  }
  .mobile-menu[open] {
    animation: menu-in 0.5s var(--ease-out-quint) both;
  }
  .mobile-menu[open] .menu-item {
    animation: item-in 0.6s var(--ease-out-quint) both;
  }
  .mobile-menu[open] .menu-item:nth-child(2) { animation-delay: 0.04s; }
  .mobile-menu[open] .menu-item:nth-child(3) { animation-delay: 0.08s; }
  .mobile-menu[open] .menu-item:nth-child(4) { animation-delay: 0.12s; }
  .mobile-menu::backdrop {
    background: transparent;
  }
  @keyframes menu-in {
    from { opacity: 0; }
  }
  @keyframes item-in {
    from { opacity: 0; transform: translateX(-1rem); }
  }
</style>

<script>
  const getMenu = () => document.querySelector<HTMLDialogElement>('[data-menu]');
  const getOpener = () => document.querySelector<HTMLButtonElement>('[data-menu-open]');

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const menu = getMenu();
    if (!target || !menu) return;
    if (target.closest('[data-menu-open]')) {
      menu.showModal();
      getOpener()?.setAttribute('aria-expanded', 'true');
    } else if (target.closest('[data-menu-close], [data-menu-link]')) {
      menu.close();
    }
  });

  document.addEventListener(
    'close',
    (event) => {
      if ((event.target as Element).matches?.('[data-menu]')) getOpener()?.setAttribute('aria-expanded', 'false');
    },
    true,
  );

  // Solid once scrolled; tucks away while reading down, returns on any upward scroll.
  let lastY = window.scrollY;
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        const header = document.querySelector('[data-header]');
        if (header) {
          header.classList.toggle('is-scrolled', y > 24);
          if (Math.abs(y - lastY) > 4) {
            header.classList.toggle('is-hidden', y > lastY && y > 200);
            lastY = y;
          }
        }
        ticking = false;
      });
    },
    { passive: true },
  );

  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  if (!isMac) document.querySelectorAll('[data-shortcut]').forEach((el) => (el.textContent = 'Ctrl K'));

  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) getMenu()?.close();
  });
</script>
