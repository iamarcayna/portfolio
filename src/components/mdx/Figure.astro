---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="case-figure">
  <div class="glow overflow-hidden bg-panel" data-reveal="clip">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1200]}
      sizes="(min-width: 1024px) 70vw, 100vw"
      class="block h-auto w-full"
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && <figcaption class="mono mt-3 text-muted">{caption}</figcaption>}
</figure>
